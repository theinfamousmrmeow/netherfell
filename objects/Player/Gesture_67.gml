if (global.controls==controlTypes.drag){
	var dist = point_distance(x,y,mouse_x,mouse_y);

	if (dist>=3){

		if (mouse_x)<x{inputDirection=180;}
		else if (mouse_x>x){inputDirection=0;}

	}
}
else if (global.controls==controlTypes.tap){

xtarget = mouse_x;

}